# NexusRAG 环境 variable 模板。复制为 .env 后按需修改。

# ---------- 基础 ----------
ENV=dev
SECRET_KEY=please-change-me-to-a-random-string
API_HOST=0.0.0.0
API_PORT=8000

# ---------- PostgreSQL ----------
# compose 内使用服务名；本机开发指向本机/远程实例
DATABASE_URL=postgresql+asyncpg://nexusrag:nexusrag@localhost:5432/nexusrag

# ---------- Redis（ARQ 队列/缓存） ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Qdrant 向量库 ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---------- LLM（OpenAI 兼容协议，一项配置覆盖主流厂商） ----------
# DeepSeek:  https://api.deepseek.com/v1
# 智谱GLM:   https://open.bigmodel.cn/api/paas/v4
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:    https://api.openai.com/v1
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# Ollama 本地模型（与上行二选一，填写后将覆盖上方配置）
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# ---------- Embedding 模型（OpenAI 兼容） ----------
# 智谱 embedding-3: https://open.bigmodel.cn/api/paas/v4 (dim=2048 可选 256/512/1024/2048)
# OpenAI:           https://api.openai.com/v1 (text-embedding-3-small dim=1536)
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=xxx
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024

# ---------- 初始管理员（首次启动自动创建） ----------
ADMIN_EMAIL=admin@nexusrag.local
ADMIN_PASSWORD=admin123

# ---------- 摄取 ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
